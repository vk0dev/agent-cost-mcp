{"version":3,"term":{"cols":80,"rows":24},"timestamp":1781196760,"command":"node scripts/demo-tool-analytics.mjs","env":{"SHELL":"/bin/zsh"}}
[0.306, "o", "\u001b[2m# Tool analytics demo: usage mix -> trend -> ROI -> anomaly -> pre-run estimate.\u001b[0m\r\n"]
[1.001, "o", "\u001b[2m# Fixture-backed local Claude Code JSONL; no billing API, no telemetry.\u001b[0m\r\n"]
[1.100, "o", "\u001b[1m$ agent-cost-mcp inspect ./local-session-logs\u001b[0m\r\n"]
[0.652, "o", "\u001b[2m  project: /var/folders/_9/mdg6clp17s123gpw80gkqyfm0000gn/T/agent-cost-tool-analytics-zuTDGU\u001b[0m\r\n"]
[0.902, "o", "\r\n"]
[0.454, "o", "\u001b[36m\u001b[1m>>> get_tool_usage days=7\u001b[0m\r\n"]
[0.651, "o", "  Edit  calls= 8 context=72.7%\r\n"]
[0.420, "o", "  Bash  calls= 1 context=9.1%\r\n"]
[0.423, "o", "  Grep  calls= 1 context=9.1%\r\n"]
[0.420, "o", "  Read  calls= 1 context=9.1%\r\n"]
[0.421, "o", "\r\n"]
[0.425, "o", "\u001b[36m\u001b[1m>>> get_cost_trend days=7\u001b[0m\r\n"]
[0.651, "o", "  sessions=5  total=\u001b[1m$2.66\u001b[0m\r\n"]
[0.620, "o", "  2026-06-06  sessions=1  spend=$0.02\r\n"]
[0.360, "o", "  2026-06-07  sessions=1  spend=$0.03\r\n"]
[0.361, "o", "  2026-06-08  sessions=1  spend=$0.03\r\n"]
[0.361, "o", "  2026-06-10  sessions=1  spend=$2.56\r\n"]
[0.361, "o", "\r\n"]
[0.424, "o", "\u001b[36m\u001b[1m>>> get_tool_roi days=7\u001b[0m\r\n"]
[0.651, "o", "  weakest: \u001b[31m\u001b[1mEdit\u001b[0m efficiency=low cost_share=$1.94\r\n"]
[0.803, "o", "  strongest: \u001b[32mRead\u001b[0m efficiency=high\r\n"]
[0.700, "o", "\r\n"]
[0.427, "o", "\u001b[36m\u001b[1m>>> detect_cost_anomalies days=7\u001b[0m\r\n"]
[0.650, "o", "  baseline=$0.53  anomalies=\u001b[33m0\u001b[0m\r\n"]
[0.702, "o", "  runaway_detected=\u001b[31m\u001b[1mtrue\u001b[0m\r\n"]
[0.651, "o", "  reason=\u001b[33mretry_storm_no_adaptation\u001b[0m\r\n"]
[0.902, "o", "\r\n"]
[0.421, "o", "\u001b[36m\u001b[1m>>> estimate_run_cost model=claude-sonnet-4 budget=$1\u001b[0m\r\n"]
[0.652, "o", "  estimate=\u001b[1m$0.13\u001b[0m  within_budget=\u001b[32mtrue\u001b[0m\r\n"]
[0.751, "o", "  pricing_model=claude-sonnet-4\r\n"]
[0.651, "o", "\r\n"]
[0.422, "o", "\u001b[32m\u001b[1mOperator readout:\u001b[0m Edit is the spend driver; trend confirms the spike; ROI/anomaly agree it should be stopped before another run.\r\n"]
[1.410, "x", "0"]
