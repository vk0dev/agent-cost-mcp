[0.086, "o", "\u001b[1m$ agent-cost-mcp demo --budget-cap\u001b[0m\r\n"]
[0.701, "o", "\u001b[2mConfiguring a warn-mode budget with 80% alerts and a 100% hard cap.\u001b[0m\r\n"]
[1.204, "o", "\u001b[36m\u001b[1mConfigured budget\u001b[0m\r\n"]
[0.502, "o", "{\r\n  \"daily_usd\": 120,\r\n  \"per_session_usd\": 40,\r\n  \"alert_thresholds\": [\r\n    50,\r\n    80,\r\n    100\r\n  ],\r\n  \"mode\": \"warn\",\r\n  \"updated_at\": \"2026-05-08T00:55:51.722Z\"\r\n}\r\n"]
[1.003, "o", "\u001b[2mBefore the crossing, the run is still below the 80% alert line.\u001b[0m\r\n"]
[1.200, "o", "\u001b[36m\u001b[1mStatus before crossing\u001b[0m\r\n"]
[0.503, "o", "{\r\n  \"budget_alert\": {\r\n    \"scope\": \"daily\",\r\n    \"threshold\": 50,\r\n    \"percentUsed\": 60,\r\n    \"limitUsd\": 120,\r\n    \"currentUsd\": 72,\r\n    \"message\": \"Daily budget at 60.0% of $120.00 cap.\"\r\n  },\r\n  \"hard_capped\": false,\r\n  \"budget_blocked\": false\r\n}\r\n"]
[0.900, "o", "\u001b[33m\u001b[1mThreshold crossed:\u001b[0m daily spend just moved above the 80% alert threshold.\r\n"]
[1.502, "o", "\u001b[36m\u001b[1mStatus after crossing\u001b[0m\r\n"]
[0.502, "o", "{\r\n  \"budget_alert\": {\r\n    \"scope\": \"daily\",\r\n    \"threshold\": 80,\r\n    \"percentUsed\": 80.33333333333333,\r\n    \"limitUsd\": 120,\r\n    \"currentUsd\": 96.4,\r\n    \"message\": \"Daily budget at 80.3% of $120.00 cap.\"\r\n  },\r\n  \"hard_capped\": false,\r\n  \"budget_blocked\": false\r\n}\r\n"]
[1.103, "o", "\u001b[33m\u001b[1mAlert fired:\u001b[0m Daily budget at 80.3% of $120.00 cap.\r\n"]
[1.700, "o", "\u001b[31m\u001b[1mCap exceeded:\u001b[0m the budget is now above 100% of the configured daily cap.\r\n"]
[1.500, "o", "\u001b[36m\u001b[1mStatus at cap\u001b[0m\r\n"]
[0.502, "o", "{\r\n  \"budget_alert\": {\r\n    \"scope\": \"daily\",\r\n    \"threshold\": 100,\r\n    \"percentUsed\": 101,\r\n    \"limitUsd\": 120,\r\n    \"currentUsd\": 121.2,\r\n    \"message\": \"Daily budget at 101.0% of $120.00 cap.\"\r\n  },\r\n  \"hard_capped\": true,\r\n  \"hard_cap_message\": \"Configured budget cap reached or exceeded.\",\r\n  \"budget_blocked\": false\r\n}\r\n"]
[1.102, "o", "\u001b[31m\u001b[1mHard-cap message:\u001b[0m Configured budget cap reached or exceeded.\r\n"]
[1.702, "o", "\u001b[32m\u001b[1mOperator takeaway:\u001b[0m alerts start at the threshold crossing, then the hard-cap message appears once the cap is exceeded.\r\n"]
