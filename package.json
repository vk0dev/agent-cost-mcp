{
  "name": "@vk0/agent-cost-mcp",
  "version": "2.3.3",
  "description": "Local-first Cost Guard for Claude Code — per-tool ROI, subagent cost attribution, anomaly/forecast/budget guardrails from local JSONL logs. Complements native /cost and ccusage.",
  "mcpName": "io.github.vk0dev/agent-cost-mcp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "agent-cost-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke": "npm run build && node scripts/dogfood_smoke.mjs",
    "version-sync": "node scripts/version-sync.mjs",
    "release-check": "node scripts/release-check.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "anthropic",
    "ai-agent",
    "jsonl",
    "local-first",
    "cost-analysis",
    "cost-analyzer",
    "cost-tracking",
    "cost-optimization",
    "token-usage",
    "budgeting",
    "budget-alerts",
    "cost-forecast",
    "anomaly-detection",
    "subagent",
    "developer-tools",
    "cost-guard",
    "ccusage",
    "roi"
  ],
  "author": "vk0.dev",
  "license": "MIT",
  "homepage": "https://vk0dev.github.io/agent-cost-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/vk0dev/agent-cost-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vk0dev/agent-cost-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
